---
import { journal } from '../../../i18n/design';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { postAvailableLocales, postLocaleHrefs } from '../../../lib/localeHrefs';
import { blogIndexHref, postHref, type Locale } from '../../../i18n/locales';
import { postStrings } from '../../../i18n/ui';
import { isPublished } from '../../../lib/publication.mjs';
import { getCollection, render } from 'astro:content';
import redirects from '../../../../article-redirects.json';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => isPublished(data, import.meta.env.PROD));
	const articlePaths = posts.map((post) => ({
		params: {
			lang: post.data.locale,
			slug: post.data.translationKey,
		},
		props: { post },
	}));
	const aliasPaths = redirects.flatMap(({ from, to }) =>
		posts.filter((p) => p.data.translationKey === to).map((p) => ({
			params: { lang: p.data.locale, slug: from },
			props: { redirectTo: postHref(p.data.locale, to) },
		})),
	);
	return [...articlePaths, ...aliasPaths];
}

if (Astro.props.redirectTo) return Astro.redirect(Astro.props.redirectTo);
const { post } = Astro.props;
const allPosts = await getCollection('blog', ({ data }) => isPublished(data, import.meta.env.PROD));
const { Content, headings } = await render(post);
const lang = post.data.locale as Locale;
const P = postStrings(lang);
const J = journal(lang);
const minutes = Math.max(1, Math.ceil((post.body ?? "").split(/\s+/).length / 200));

const localeHrefs = postLocaleHrefs(allPosts, post.data.translationKey);
const availableLocales = postAvailableLocales(allPosts, post.data.translationKey);
const series = allPosts.filter(p => p.data.locale === lang && /^\d{3}-/.test(p.data.translationKey)).sort((a,b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
const position = series.findIndex(p => p.data.translationKey === post.data.translationKey);
const previous = position > 0 ? series[position-1] : undefined;
const next = position >= 0 ? series[position+1] : undefined;
const seriesLabel = lang === 'ar' ? 'فهاد السلسلة' : lang === 'fr' ? 'Dans cette série' : 'In this series';
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	lang={lang}
	localeHrefs={localeHrefs}
	availableLocales={availableLocales}
>
	<div class="reading-layout shell"><article class="article">
		<header class="article-head">
			<p class="back">
				<a href={blogIndexHref(lang)}>{P.backToBlog}</a>
			</p>
			<h1>{post.data.title}</h1>
			<p class="desc">{post.data.description}</p>
			<div class="byline"><span>Nada Tayebi</span><span class="sep">·</span><span>{minutes} {J.minutes}</span><span class="sep">·</span>
				<time datetime={post.data.pubDate.toISOString()}>
					{P.published}{' '}
					{post.data.pubDate.toLocaleDateString(lang === 'ar' ? 'ar' : lang === 'fr' ? 'fr' : 'en')}
				</time>
				{
					post.data.updatedDate && (
						<>
							<span class="sep">·</span>
							<time datetime={post.data.updatedDate.toISOString()}>
								{P.updated}{' '}
								{post.data.updatedDate.toLocaleDateString(lang === 'ar' ? 'ar' : lang === 'fr' ? 'fr' : 'en')}
							</time>
						</>
					)
				}
			</div>
			{
				post.data.tags && post.data.tags.length > 0 && (
					<ul class="tags">
						{post.data.tags.map((t) => (
							<li>{t}</li>
						))}
					</ul>
				)
			}
		</header>
		{headings.some(h=>h.depth===2) && <details class="mobile-contents"><summary>{J.contents}</summary><nav aria-label={J.contents}><ol>{headings.filter(h=>h.depth===2).map(h=><li><a href={"#"+h.slug}>{h.text}</a></li>)}</ol></nav></details>}
<div class="prose">
			<Content />
		</div>
	</article>{headings.some(h=>h.depth===2) && <aside class="contents"><nav aria-label={J.contents}><p class="eyebrow">{J.contents}</p><ol>{headings.filter(h=>h.depth===2).map(h=><li><a href={"#"+h.slug}>{h.text}</a></li>)}</ol></nav></aside>}</div>
</BaseLayout>
