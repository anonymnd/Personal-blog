---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntryCard from '../../../components/EntryCard.astro';
import CategorySidebar from '../../../components/CategorySidebar.astro';
import { blogIndexLocaleHrefs } from '../../../lib/localeHrefs';
import { type Locale, locales } from '../../../i18n/locales';
import { journal } from '../../../i18n/design';
import { blogIndexStrings } from '../../../i18n/ui';
import { isPublished } from '../../../lib/publication.mjs';
import { getCollection, type CollectionEntry } from 'astro:content';
export async function getStaticPaths({ paginate }: { paginate: Function }) {
	const allPosts = await getCollection('blog', ({ data }) => isPublished(data, import.meta.env.PROD));
	return locales.flatMap((lang) => {
		const posts = allPosts
			.filter((p) => p.data.locale === lang)
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
		return paginate(posts, { params: { lang }, pageSize: 20 });
	});
}
const lang = Astro.params.lang as Locale, J = journal(lang), B = blogIndexStrings(lang);
const { page } = Astro.props as { page: { data: CollectionEntry<'blog'>[]; currentPage: number; lastPage: number; url: { prev?: string; next?: string } } };
const posts = page.data;
const allPostsForSidebar = (await getCollection('blog', ({ data }) => isPublished(data, import.meta.env.PROD) && data.locale === lang));
const tags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort();
const totalForIntro = allPostsForSidebar.length;
---
<BaseLayout title={J.library} description={B.intro(totalForIntro)} lang={lang} localeHrefs={blogIndexLocaleHrefs()}>
 <section class="library shell"><header class="library-head"><h1>{J.library}</h1><p>{B.intro(totalForIntro)} {J.note}</p></header>
 <div class="library-with-sidebar"><CategorySidebar lang={lang} posts={allPostsForSidebar}/><div class="library-results"><div class="library-tools" hidden><div><label for="article-search">{J.search}</label><input id="article-search" type="search" placeholder={J.placeholder}/></div><div><label for="article-topic">{J.topic}</label><select id="article-topic"><option value="">{J.all}</option>{tags.map(tag=><option value={tag}>{tag}</option>)}</select></div></div>
 <p id="search-status" class="search-status" aria-live="polite" data-label={J.results}></p>
 <ul class="post-grid library-grid">{posts.map(post=><li data-entry data-search={[post.data.title,post.data.description,...(post.data.tags??[])].join(' ').toLocaleLowerCase(lang)} data-tags={JSON.stringify(post.data.tags??[])}><EntryCard post={post} lang={lang}/></li>)}</ul><p id="search-empty" hidden>{J.empty}</p>
 {page.lastPage > 1 && <nav class="pagination" aria-label={B.pageOf(page.currentPage, page.lastPage)}>
	<a href={page.url.prev ?? '#'} class="pagination-prev" aria-disabled={!page.url.prev} rel="prev">{B.prev}</a>
	<span class="pagination-status">{B.pageOf(page.currentPage, page.lastPage)}</span>
	<a href={page.url.next ?? '#'} class="pagination-next" aria-disabled={!page.url.next} rel="next">{B.next}</a>
 </nav>}
 </div></div></section>
</BaseLayout>
<script>
const tools=document.querySelector<HTMLElement>('.library-tools');
const search=document.querySelector<HTMLInputElement>('#article-search');
const topic=document.querySelector<HTMLSelectElement>('#article-topic');
const entries=[...document.querySelectorAll<HTMLElement>('[data-entry]')];
const status=document.querySelector<HTMLElement>('#search-status');
if(tools&&search&&topic&&status){tools.hidden=false;search.value=new URLSearchParams(location.search).get('q')??'';const filter=()=>{const q=search.value.trim().toLocaleLowerCase(document.documentElement.lang);let count=0;for(const entry of entries){const tags=JSON.parse(entry.dataset.tags??'[]');entry.hidden=!(entry.dataset.search?.includes(q)&&(!topic.value||tags.includes(topic.value)));if(!entry.hidden)count++;}status.textContent=count+' '+status.dataset.label;document.querySelector<HTMLElement>('#search-empty')!.hidden=count!==0;};search.addEventListener('input',filter);topic.addEventListener('change',filter);filter();}
</script>
<style>
.pagination{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid var(--border)}
.pagination a{font-size:0.9rem;font-weight:650;color:var(--accent);text-decoration:none}
.pagination a[aria-disabled="true"]{visibility:hidden}
.pagination a:hover{color:var(--accent-dim)}
.pagination-status{font-size:0.82rem;color:var(--text-muted);font-family:var(--font-mono)}
</style>
