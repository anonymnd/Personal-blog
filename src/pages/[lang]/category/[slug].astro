---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntryCard from '../../../components/EntryCard.astro';
import CategorySidebar from '../../../components/CategorySidebar.astro';
import { blogIndexLocaleHrefs } from '../../../lib/localeHrefs';
import { type Locale, locales } from '../../../i18n/locales';
import { categories, categoryFor, categoryLabel, type CategorySlug } from '../../../lib/categories';
import { isPublished } from '../../../lib/publication.mjs';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
	return locales.flatMap(lang => categories.map(slug => ({ params: { lang, slug } })));
}

const lang = Astro.params.lang as Locale;
const slug = Astro.params.slug as CategorySlug;
const allPosts = (await getCollection('blog', ({ data }) => isPublished(data, import.meta.env.PROD) && data.locale === lang)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const posts = allPosts.filter(p => categoryFor(p.data) === slug);
const title = categoryLabel(slug, lang);
---
<BaseLayout title={title} description={title} lang={lang} localeHrefs={blogIndexLocaleHrefs()}>
	<section class="library shell">
		<header class="library-head"><h1>{title}</h1></header>
		<div class="library-with-sidebar">
			<CategorySidebar lang={lang} posts={allPosts} current={slug} />
			<div class="library-results">
				<ul class="post-grid library-grid">{posts.map(post => <li><EntryCard post={post} lang={lang} /></li>)}</ul>
			</div>
		</div>
	</section>
</BaseLayout>
