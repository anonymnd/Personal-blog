---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import { homeLocaleHrefs } from '../../lib/localeHrefs';
import { blogIndexHref, postHref, type Locale, locales } from '../../i18n/locales';
import { layoutStrings } from '../../i18n/ui';
import { journal } from '../../i18n/design';
import { isPublished } from '../../lib/publication.mjs';
import { getCollection } from 'astro:content';
export function getStaticPaths() { return locales.map(lang => ({params:{lang}})); }
const lang=Astro.params.lang as Locale;
const J=journal(lang), L=layoutStrings(lang);
const posts=(await getCollection('blog',({data})=>isPublished(data,import.meta.env.PROD)&&data.locale===lang)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const latest=posts[0];
---
<BaseLayout title={L.siteTitle} description={J.lead} lang={lang} localeHrefs={homeLocaleHrefs()}>
 <section class="journal-hero shell">
  <div class="hero-copy"><p class="eyebrow">{J.eyebrow}</p><h1>{J.title.split('\n').map(line=><span>{line}</span>)}</h1><p class="lead">{J.lead}</p><a class="button" href={blogIndexHref(lang)}>{J.archive}<span aria-hidden="true" class="arrow">↗</span></a><p class="language-note">{J.languages}</p></div>
  <div class="magazine-poster" aria-hidden="true"><div class="poster-top"><span>N / T</span><span>THE SOFTWARE EDIT</span></div><svg class="poster-art" viewBox="0 0 480 390" fill="none"><path d="M35 80 220 20l220 85-190 75z" fill="#8b5cf6"/><path d="m35 160 185-60 220 85-190 75z" fill="#2563eb"/><path d="m35 240 185-60 220 85-190 75z" fill="#e5ddff"/><path d="M250 180v80M250 260v80M35 80v160M440 105v160" stroke="#fff" stroke-opacity=".5" stroke-width="2"/><circle cx="350" cy="340" r="30" stroke="#8b5cf6" stroke-width="2"/><path d="M350 310v60m-30-30h60" stroke="#8b5cf6" stroke-width="2"/></svg><div class="poster-bottom"><span>THINK. BUILD. REPEAT.</span><span>01 — ∞</span></div></div>
 </section>
 {latest && <section class="featured shell"><div class="feature-label"><span class="eyebrow">{J.latest}</span><span class="feature-number" aria-hidden="true">{String(latest.data.seriesOrder??1).padStart(2,'0')}</span></div><div><p class="entry-meta">{latest.data.tags?.[0]} <span> / </span> <time datetime={latest.data.pubDate.toISOString()}>{latest.data.pubDate.toLocaleDateString(lang,{month:'long',day:'numeric',year:'numeric'})}</time></p><h2><a href={postHref(lang,latest.data.translationKey)}>{latest.data.title}</a></h2><p>{latest.data.description}</p><a class="text-link" href={postHref(lang,latest.data.translationKey)}>{J.read}<span class="arrow" aria-hidden="true">↗</span></a></div></section>}
 <section class="recent shell"><div class="section-head"><h2>{J.entries}</h2><a class="text-link" href={blogIndexHref(lang)}>{J.archive}<span class="arrow" aria-hidden="true">↗</span></a></div><ul class="post-grid">{posts.slice(1,7).map(post=><li><EntryCard post={post} lang={lang}/></li>)}</ul></section>
 <section class="journal-signoff shell"><p class="eyebrow">{J.eyebrow}</p><h2>{J.note}</h2><p>{J.languages}</p></section>
</BaseLayout>
