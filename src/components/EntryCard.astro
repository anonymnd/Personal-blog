---
import { postHref, type Locale } from '../i18n/locales';
import { journal } from '../i18n/design';
import { categoryFor } from '../lib/categories';
import { categoryVisual } from '../lib/category-visuals';
const { post, lang } = Astro.props;
const J = journal(lang as Locale);
const visual = categoryVisual(categoryFor(post.data));
---
<a class="entry-card" href={postHref(lang, post.data.translationKey)}>
 <svg class="entry-visual" viewBox="0 0 140 100" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label={visual.label} set:html={visual.svg} />
 <div class="entry-meta"><span>{post.data.tags?.[0] ?? J.eyebrow}</span><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString(lang, {month:'short',day:'numeric',year:'numeric'})}</time></div>
 <h3>{post.data.title}</h3>
 <p>{post.data.description}</p>
 <span class="entry-read">{J.read}<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></span>
</a>
<style is:global>
 .entry-visual{display:block;width:100%;height:auto;max-height:9.5rem;margin-bottom:.9rem;padding:.7rem .9rem;box-sizing:border-box;color:#354bc4;background:#eef0fb;border-radius:8px}
 .entry-visual text{fill:currentColor;stroke:none;font:600 7px var(--font-sans,'Public Sans',sans-serif);letter-spacing:0}
 .entry-visual .lbl{font-weight:500;font-size:6px;opacity:.75}
 @media (prefers-color-scheme:dark){.entry-visual{background:#1d2140;color:#aab6ff;--accent:#ffd27a}}
</style>
