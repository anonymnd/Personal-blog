---
interface Band {
	name: string;
	range: string;
	color: string;
	desc: string;
}

const bands: Band[] = [
	{ name: 'Delta', range: '0.5–4 Hz', color: '#6366f1', desc: 'Dominant during deep, dreamless sleep. In adults, strong delta while awake can indicate brain dysfunction.' },
	{ name: 'Theta', range: '4–8 Hz', color: '#8b5cf6', desc: 'Seen in drowsiness, light sleep, and sometimes during deep meditation. Also appears in memory tasks.' },
	{ name: 'Alpha', range: '8–13 Hz', color: '#a78bfa', desc: 'Strongest when relaxed with eyes closed, especially at posterior (occipital) sites. Suppresses when eyes open.' },
	{ name: 'Beta', range: '13–30 Hz', color: '#c084fc', desc: 'Associated with active thinking, focus, and motor planning. High beta can accompany anxiety or muscle tension.' },
	{ name: 'Gamma', range: '30–100+ Hz', color: '#e879f9', desc: 'The fastest band; linked to binding features into perception and high-level cognitive processing.' },
];
---

<figure class="freq-bands-figure" role="group" aria-labelledby="freq-bands-title">
	<figcaption id="freq-bands-title" class="freq-bands-title">
		EEG frequency bands
	</figcaption>

	<div class="spectrum" role="img" aria-label="Spectrum bar from delta (0.5 Hz) to gamma (100+ Hz)">
		{bands.map((band, i) => (
			<div
				class="band-segment"
				style={`--band-color: ${band.color}; --band-pos: ${i / bands.length};`}
				data-band={band.name}
				tabindex="0"
				role="button"
				aria-label={`${band.name}: ${band.range}`}
			>
				<span class="band-name">{band.name}</span>
				<span class="band-range">{band.range}</span>
			</div>
		))}
	</div>

	<div class="band-details" aria-live="polite">
		{bands.map((band, i) => (
			<div class="band-detail" data-band={band.name} hidden={i !== 0}>
				<h4 style={`color: ${band.color}`}>{band.name} <span class="detail-range">{band.range}</span></h4>
				<p>{band.desc}</p>
			</div>
		))}
	</div>

	<p class="freq-bands-caption">
		<em>Figure 2:</em> The five canonical EEG frequency bands. Hover or tap a band to read what it typically indicates — remembering that interpretation always depends on context (region, task, individual).
	</p>
</figure>

<style>
	.freq-bands-figure {
		margin: 2rem 0 2.5rem;
		padding: 1.4rem;
		background: #eeedf9;
		border: 1px solid #dcd6ee;
		border-inline-start: 4px solid var(--accent-dim);
		border-radius: 0 14px 14px 0;
	}

	.freq-bands-title {
		font-size: 0.7rem;
		font-weight: 650;
		color: #634a98;
		margin-bottom: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.spectrum {
		display: flex;
		height: 64px;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid #d0c8e8;
	}

	.band-segment {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.15rem;
		background: color-mix(in srgb, var(--band-color) 22%, #fff);
		border-inline-end: 1px solid #d0c8e8;
		cursor: pointer;
		transition: background 0.15s, transform 0.15s;
		outline: none;
		min-width: 0;
		padding: 0.3rem;
	}
	.band-segment:last-child { border-inline-end: none; }

	.band-segment:hover,
	.band-segment:focus-visible,
	.band-segment[aria-pressed="true"] {
		background: color-mix(in srgb, var(--band-color) 45%, #fff);
		z-index: 1;
	}

	.band-segment:focus-visible {
		box-shadow: inset 0 0 0 2px var(--accent);
	}

	.band-name {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--text);
	}

	.band-range {
		font-size: 0.65rem;
		color: var(--text-muted);
		font-family: var(--font-mono);
	}

	.band-details {
		margin-top: 1rem;
		min-height: 4.5rem;
	}

	.band-detail h4 {
		font-size: 0.95rem;
		margin: 0 0 0.4rem;
	}
	.detail-range {
		font-size: 0.78rem;
		font-weight: 400;
		color: var(--text-muted);
		font-family: var(--font-mono);
	}
	.band-detail p {
		font-size: 0.88rem;
		line-height: 1.75;
		margin: 0;
		color: var(--text);
	}

	.freq-bands-caption {
		font-size: 0.95rem;
		line-height: 1.5;
		font-weight: 700;
		color: var(--text);
		text-wrap: balance;
		margin: 1rem 0 0;
	}

	@media (max-width: 560px) {
		.band-name { font-size: 0.68rem; }
		.band-range { font-size: 0.58rem; }
		.spectrum { height: 56px; }
	}
</style>

<script>
	const segments = document.querySelectorAll<HTMLElement>('.band-segment');
	const details = document.querySelectorAll<HTMLElement>('.band-detail');

	const activate = (bandName: string) => {
		segments.forEach((s) => s.setAttribute('aria-pressed', String(s.dataset.band === bandName)));
		details.forEach((d) => { d.hidden = d.dataset.band !== bandName; });
	};

	segments.forEach((seg) => {
		seg.addEventListener('mouseenter', () => activate(seg.dataset.band ?? ''));
		seg.addEventListener('focus', () => activate(seg.dataset.band ?? ''));
		seg.addEventListener('click', () => activate(seg.dataset.band ?? ''));
		seg.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				activate(seg.dataset.band ?? '');
			}
		});
	});
</script>
