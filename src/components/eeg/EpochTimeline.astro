---
interface Props { duration?: number; pre?: number; post?: number }
const { duration = 20, pre = 0.5, post = 1.0 } = Astro.props;

// Deterministic EEG-ish trace
function trace(w = 640, h = 96, seed = 91): string {
	let s = seed; const pts: string[] = [];
	for (let x = 0; x <= w; x += 3) {
		s = (s * 16807 + 12345) % 2147483647;
		const env = Math.sin((x / w) * Math.PI * 4) * 0.4 + 0.6;
		const y = h / 2 + (((s % 100) / 100) - 0.5) * h * 0.7 * env;
		pts.push(`${x},${y.toFixed(1)}`);
	}
	return pts.join(' ');
}

const events = [6, 13.5];
---

<figure class="fig fig--paper epoch-fig">
	<p class="fig-kicker">Figure · epoching</p>
	<h3 class="fig-title">Cutting a 20-second stream into 1.5-second experiments</h3>

	<div class="epoch" data-duration={duration}>
		<div class="track" role="slider" tabindex="0"
			aria-label="Epoch window position" aria-valuemin="0" aria-valuemax={duration} aria-valuenow={duration / 2}
			aria-valuetext="epoch centred at 10.0 seconds">
			<svg class="trace" viewBox="0 0 640 96" preserveAspectRatio="none" aria-hidden="true">
				<polyline points={trace()} fill="none" stroke="#8f86b8" stroke-width="1.6" stroke-linejoin="round" />
			</svg>

			{events.map((t) => (
				<div class="pin" style={`left:${(t / duration) * 100}%`}>
					<span class="pin-dot"></span>
					<span class="pin-lab">{t.toFixed(1)}s</span>
				</div>
			))}

			<div class="win"><span class="win-edge start"></span><span class="win-edge end"></span></div>
		</div>

		<div class="readout">
			<span>Window <b class="r-start">−0.5 s</b> → <b class="r-end">+1.0 s</b></span>
			<span>Width <b class="r-width">1.5 s</b></span>
		</div>

		<div class="knobs">
			<label class="knob">Pre-stimulus (s)
				<input class="k-pre" type="number" value={pre} min="0" max="2" step="0.1" />
			</label>
			<label class="knob">Post-stimulus (s)
				<input class="k-post" type="number" value={post} min="0" max="3" step="0.1" />
			</label>
		</div>

		<p class="result" aria-live="polite">
			Every marker yields <b>1.5 s</b> of signal — one candidate example, as long as it stays on a single side of the train/test split.
		</p>
	</div>

	<p class="fig-note">
		Drag the window or use <em>arrow keys</em> (hold Shift to jump further). Widen it and you keep more context
		but blur the moment you cared about; narrow it and you risk cutting off the response.
		Cutting finer also makes <em>more</em> examples — but not more independent ones, which comes back later.
	</p>
</figure>

<style>
	.epoch{--dur:20}
	.track{position:relative;height:104px;background:#fff;border:1px solid #ddd3f0;border-radius:10px;
		cursor:grab;overflow:hidden;outline:none;box-shadow:inset 0 1px 0 #f0ecf9}
	.track:active{cursor:grabbing}
	.track:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
	.trace{position:absolute;inset:0;width:100%;height:100%;padding:0 .4rem;box-sizing:border-box}

	.pin{position:absolute;top:0;bottom:0;width:0;z-index:3}
	.pin-dot{position:absolute;top:8px;left:50%;width:11px;height:11px;background:var(--accent);
		border:2.5px solid #fff;border-radius:50%;box-shadow:2px 2px 0 #c6b6e5;transform:translateX(-50%)}
	.pin-lab{position:absolute;top:24px;left:50%;transform:translateX(-50%);padding:.1rem .4rem;background:var(--accent);
		color:#fff;border-radius:5px;font-size:.6rem;font-family:var(--font-mono);font-weight:650;white-space:nowrap}

	.win{position:absolute;top:0;bottom:0;background:rgba(112,65,189,.13);
		border-inline:2px solid var(--accent-dim);z-index:2}
	.win-edge{position:absolute;top:0;bottom:0;width:3px;background:var(--accent-dim)}
	.win-edge.start{inset-inline-start:-2px}.win-edge.end{inset-inline-end:-2px}

	.readout{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.5rem;margin-top:.6rem;
		font-size:.8rem;color:var(--text-muted)}
	.readout b{font-family:var(--font-mono);color:var(--accent-dim);font-weight:650}

	.knobs{display:flex;gap:1rem;margin-top:.85rem;flex-wrap:wrap}
	.knob{display:flex;flex-direction:column;gap:.3rem;font-size:.78rem;font-weight:650;color:var(--text-muted)}
	.knob input{width:6.5rem;min-height:44px;padding:.4rem .7rem;border:1px solid #9c8ab9;border-radius:9px;
		background:#fff;color:var(--text);font-family:var(--font-mono);font-size:.88rem}
	.knob input:focus-visible{outline:3px solid var(--accent);outline-offset:2px}

	.result{margin:.9rem 0 0;padding:.65rem .85rem;background:#fff;border:1px solid #e2ddf0;
		border-inline-start:5px solid var(--accent);border-radius:0 10px 10px 0;font-size:.85rem;line-height:1.7;color:var(--text)}
	.result b{color:var(--accent-dim);font-weight:750}
</style>

<script>
	document.querySelectorAll<HTMLElement>('.epoch').forEach((demo) => {
		const dur = parseFloat(demo.dataset.duration ?? '20');
		const track = demo.querySelector<HTMLElement>('.track')!;
		const win = demo.querySelector<HTMLElement>('.win')!;
		const rS = demo.querySelector<HTMLElement>('.r-start')!;
		const rE = demo.querySelector<HTMLElement>('.r-end')!;
		const rW = demo.querySelector<HTMLElement>('.r-width')!;
		const res = demo.querySelector<HTMLElement>('.result')!;
		const kPre = demo.querySelector<HTMLInputElement>('.k-pre')!;
		const kPost = demo.querySelector<HTMLInputElement>('.k-post')!;
		let centre = dur / 2, pre = parseFloat(kPre.value), post = parseFloat(kPost.value);

		const render = () => {
			const half = ((pre + post) / dur) * 50, pct = (centre / dur) * 100;
			win.style.left = `${pct - half}%`; win.style.width = `${half * 2}%`;
			track.setAttribute('aria-valuenow', centre.toFixed(1));
			track.setAttribute('aria-valuetext', `epoch centred at ${centre.toFixed(1)} seconds`);
			rS.textContent = `−${pre.toFixed(1)} s`; rE.textContent = `+${post.toFixed(1)} s`;
			const w = pre + post; rW.textContent = `${w.toFixed(1)} s`;
			res.innerHTML = `Every marker yields <b>${w.toFixed(1)} s</b> of signal — one candidate example, as long as it stays on a single side of the train/test split.`;
		};
		kPre.addEventListener('input', () => { pre = parseFloat(kPre.value) || 0; render(); });
		kPost.addEventListener('input', () => { post = parseFloat(kPost.value) || 0; render(); });

		let dragging = false;
		const move = (x: number) => { const r = track.getBoundingClientRect();
			centre = Math.max(0, Math.min(1, (x - r.left) / r.width)) * dur; render(); };
		track.addEventListener('pointerdown', (e) => { dragging = true; track.setPointerCapture(e.pointerId); move(e.clientX); });
		track.addEventListener('pointermove', (e) => { if (dragging) move(e.clientX); });
		track.addEventListener('pointerup', () => { dragging = false; });
		track.addEventListener('keydown', (e) => {
			const step = e.shiftKey ? 1 : 0.25;
			if (e.key === 'ArrowRight') { centre = Math.min(dur, centre + step); render(); e.preventDefault(); }
			if (e.key === 'ArrowLeft')  { centre = Math.max(0, centre - step); render(); e.preventDefault(); }
		});
		render();
	});
</script>
