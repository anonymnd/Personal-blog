---
interface Props { channels?: string[]; timePoints?: number }
const { channels = ['Fp1','Fp2','F3','Fz','F4','C3','Cz','C4','P3','Pz','P4','O1','O2'], timePoints = 48 } = Astro.props;

// Deterministic value in [-1,1] so the diverging scale reads correctly
function v(ch: number, t: number): number {
	let s = (ch * 31 + t * 17 + 7) % 2147483647;
	s = (s * 16807) % 2147483647;
	return ((s % 200) / 100) - 1;
}

const modes = [
	{ id: 'raw',      label: 'Raw',      note: 'Full bandwidth — drifts and line noise included.' },
	{ id: 'filtered', label: 'Filtered', note: 'Band-passed — say, to 1–40 Hz — so slow drift and high-frequency hiss are gone.' },
	{ id: 'epoch',    label: 'Epochs',   note: 'Cut into 1.5-second windows locked to the stimulus.' },
];

// Diverging ink ramp: blue (negative) → paper (zero) → violet (positive)
function ramp(x: number): string {
	const a = Math.min(1, Math.abs(x));
	const mix = (c1: number[], c2: number[], t: number) =>
		c1.map((c, i) => Math.round(c + (c2[i] - c) * t));
	const paper = [255, 255, 255];
	const neg = [53, 75, 196];    // --accent blue
	const pos = [112, 65, 189];   // --accent-dim violet
	const target = x < 0 ? neg : pos;
	const [r, g, b] = mix(paper, target, a * 0.92);
	return `rgb(${r} ${g} ${b})`;
}
---

<figure class="fig fig--paper heat-fig">
	<p class="fig-kicker">Figure · channels × time</p>
	<h3 class="fig-title">One recording, three stages: a grid of voltages</h3>

	<div class="heat" data-mode="raw">
		<div class="heat-tabs" role="tablist" aria-label="Processing stage">
			{modes.map((m, i) => (
				<button type="button" class="tab" role="tab" data-mode={m.id}
					aria-selected={i === 0 ? 'true' : 'false'}>{m.label}</button>
			))}
		</div>
		<p class="heat-note" aria-live="polite">{modes[0].note}</p>

		{/* One grid holds the labels and the cells so their rows can never drift apart.
		    minmax(0,1fr) on the cell tracks is what keeps 48 columns from inflating. */}
		<div class="heat-scroll">
			<div class="heat-grid" style={`--cols:${timePoints};--rows:${channels.length}`}
				role="img" aria-label={`Voltage heatmap: ${channels.length} channels across ${timePoints} time points`}>
				{channels.map((c, ci) => (
					<>
						<span class="lbl" aria-hidden="true">{c}</span>
						{Array.from({ length: timePoints }, (_, ti) => {
							const val = v(ci, ti);
							return (
								<i class="cell" style={`--c:${ramp(val)}`}
									data-ch={c} data-t={ti} data-v={val.toFixed(2)}></i>
							);
						})}
					</>
				))}
			</div>
		</div>

		<div class="heat-key" aria-hidden="true">
			<span>−40 µV</span>
			<span class="key-bar"></span>
			<span>+40 µV</span>
		</div>
		<div class="heat-tip" role="tooltip" hidden></div>
	</div>

	<p class="fig-note">
		Each cell is one sample. <em>Blue</em> is negative voltage, <em>violet</em> positive. Filtering removes
		what you ask it to remove — but it can also reshape what is left, so those settings need a reason.
		Epoching then keeps only the windows around an event and sets the rest aside.
	</p>
</figure>

<style>
	.heat{position:relative}
	.heat-tabs{display:flex;gap:.4rem;margin-bottom:.5rem}
	.tab{min-height:40px;padding:.45rem .95rem;border:1px solid #beb0d5;border-radius:9px;background:#fff;color:#563484;
		font-size:.8rem;font-weight:650;cursor:pointer;transition:background .18s,color .18s,border-color .18s}
	.tab:hover{background:#e1d9f2}
	.tab[aria-selected=true]{background:var(--accent);color:#fff;border-color:var(--accent);box-shadow:3px 3px 0 #c6b6e5}
	.tab:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
	.heat-note{font-size:.78rem;color:var(--text-muted);margin:0 0 .7rem;min-height:1.4em}

	.heat-scroll{min-width:0}
	.heat-grid{display:grid;min-width:0;
		grid-template-columns:auto repeat(var(--cols,48),minmax(0,1fr));
		grid-auto-rows:minmax(0,auto);gap:2px;align-items:center;
		padding:4px;background:#fff;border:1px solid #ddd3f0;border-radius:8px}
	.lbl{font-size:.58rem;font-family:var(--font-mono);color:var(--text-muted);
		white-space:nowrap;justify-self:end;padding-inline-end:.4rem;line-height:1.2}
	.cell{display:block;aspect-ratio:1;min-width:0;min-height:0;border-radius:2px;background:var(--c);
		transition:transform .12s,outline-color .12s;outline:2px solid transparent}
	.cell:hover{transform:scale(1.35);outline-color:var(--text);position:relative;z-index:2}

	.heat-key{display:flex;align-items:center;gap:.5rem;justify-content:flex-end;margin-top:.5rem;
		font-size:.64rem;font-family:var(--font-mono);color:var(--text-muted)}
	.key-bar{flex:0 0 120px;height:9px;border-radius:5px;
		background:linear-gradient(to right,rgb(53 75 196),#fff,rgb(112 65 189));border:1px solid #ddd3f0}

	.heat-tip{position:absolute;padding:.3rem .6rem;background:#20243c;color:#fff;border-radius:6px;
		font-size:.72rem;font-family:var(--font-mono);white-space:nowrap;pointer-events:none;z-index:6;
		transform:translate(-50%,-100%);opacity:0;transition:opacity .12s}
	.heat-tip[data-visible=true]{opacity:1}

	@media(prefers-reduced-motion:reduce){.cell,.tab{transition:none}.cell:hover{transform:none}}
	/* On phones the 48 columns would shrink below legibility, so the strip keeps a
	   floor cell size and scrolls sideways inside the card instead of crushing. */
	@media(max-width:560px){
		.heat-scroll{overflow-x:auto;overflow-y:hidden;scrollbar-width:thin;padding-bottom:.3rem}
		.heat-grid{min-width:max-content;gap:1px;
			grid-template-columns:auto repeat(var(--cols,48),minmax(5px,1fr))}
		.lbl{font-size:.5rem}
	}
</style>

<script>
	const notes: Record<string,string> = {
		raw: 'Full bandwidth — drifts and line noise included.',
		filtered: 'Band-passed — say, to 1–40 Hz — so slow drift and high-frequency hiss are gone.',
		epoch: 'Cut into 1.5-second windows locked to the stimulus.',
	};
	document.querySelectorAll<HTMLElement>('.heat').forEach((heat) => {
		const tabs = heat.querySelectorAll<HTMLButtonElement>('.tab');
		const note = heat.querySelector<HTMLElement>('.heat-note');
		tabs.forEach((t) => t.addEventListener('click', () => {
			tabs.forEach((o) => o.setAttribute('aria-selected', String(o === t)));
			heat.dataset.mode = t.dataset.mode ?? 'raw';
			if (note) note.textContent = notes[t.dataset.mode ?? 'raw'] ?? '';
		}));

		const tip = heat.querySelector<HTMLElement>('.heat-tip');
		if (!tip) return;
		heat.querySelectorAll<HTMLElement>('.cell').forEach((c) => {
			c.addEventListener('mouseenter', () => {
				const r = c.getBoundingClientRect(), hr = heat.getBoundingClientRect();
				tip.textContent = `${c.dataset.ch} · t=${c.dataset.t} · ${(parseFloat(c.dataset.v ?? '0') * 40).toFixed(1)} µV`;
				tip.hidden = false; tip.dataset.visible = 'true';
				tip.style.left = `${r.left + r.width / 2 - hr.left}px`;
				tip.style.top = `${r.top - hr.top - 6}px`;
			});
			c.addEventListener('mouseleave', () => { tip.dataset.visible = 'false';
				setTimeout(() => { if (tip.dataset.visible === 'false') tip.hidden = true; }, 120); });
		});
	});
</script>
