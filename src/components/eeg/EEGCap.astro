---
interface Props {
	highlight?: string[];
}
const { highlight = [] } = Astro.props;

interface Electrode { label: string; x: number; y: number; region: string }

// 10-20 positions on a 320×340 canvas (head circle cx=160 cy=170 r=118)
const electrodes: Electrode[] = [
	{ label: 'Fp1', x: 126, y: 84,  region: 'frontal pole' },
	{ label: 'Fp2', x: 194, y: 84,  region: 'frontal pole' },
	{ label: 'F7',  x: 88,  y: 122, region: 'frontal' },
	{ label: 'F3',  x: 122, y: 112, region: 'frontal' },
	{ label: 'Fz',  x: 160, y: 104, region: 'frontal midline' },
	{ label: 'F4',  x: 198, y: 112, region: 'frontal' },
	{ label: 'F8',  x: 232, y: 122, region: 'frontal' },
	{ label: 'C3',  x: 112, y: 170, region: 'central' },
	{ label: 'Cz',  x: 160, y: 170, region: 'central midline' },
	{ label: 'C4',  x: 208, y: 170, region: 'central' },
	{ label: 'T7',  x: 56,  y: 168, region: 'temporal' },
	{ label: 'T8',  x: 264, y: 168, region: 'temporal' },
	{ label: 'P3',  x: 122, y: 228, region: 'parietal' },
	{ label: 'Pz',  x: 160, y: 232, region: 'parietal midline' },
	{ label: 'P4',  x: 198, y: 228, region: 'parietal' },
	{ label: 'P7',  x: 82,  y: 244, region: 'parietal' },
	{ label: 'P8',  x: 238, y: 244, region: 'parietal' },
	{ label: 'O1',  x: 134, y: 274, region: 'occipital' },
	{ label: 'O2',  x: 186, y: 274, region: 'occipital' },
];

const active = new Set(highlight);
---

<figure class="fig fig--paper eeg-fig">
	<p class="fig-kicker">Figure · scalp map</p>
	<h3 class="fig-title">Where the numbers come from: 19 electrodes on one scalp</h3>

	<div class="eeg-stage">
		<svg viewBox="0 0 320 340" class="eeg-svg" role="group"
			aria-label="Top-down head diagram with 19 electrodes from the international 10-20 system">
			<title>EEG 10-20 electrode placement</title>

			<!-- nose + ears -->
			<path class="eeg-nose" d="M160 44 L148 20 L172 20 Z" />
			<path class="eeg-ear" d="M42 156 q-18 14 0 28" />
			<path class="eeg-ear" d="M278 156 q18 14 0 28" />

			<!-- head -->
			<circle class="eeg-head" cx="160" cy="170" r="118" />

			<!-- midline guides (dashed, like the idea-map) -->
			<line class="eeg-guide" x1="160" y1="54" x2="160" y2="286" />
			<line class="eeg-guide" x1="60" y1="170" x2="260" y2="170" />
			<circle class="eeg-ring" cx="160" cy="170" r="66" />

			{electrodes.map((el) => {
				const on = active.has(el.label);
				return (
					<g class={`eeg-el${on ? ' is-on' : ''}`} data-label={el.label} data-region={el.region}
						tabindex="0" role="button" aria-label={`${el.label} — ${el.region}`}>
						<circle class="eeg-hit" cx={el.x} cy={el.y} r="15" />
						<circle class="eeg-dot" cx={el.x} cy={el.y} r={on ? 6.5 : 5} />
						<text class="eeg-lab" x={el.x} y={el.y - 11} text-anchor="middle">{el.label}</text>
					</g>
				);
			})}
		</svg>
		<div class="eeg-tip" role="tooltip" hidden></div>
	</div>

	<p class="fig-note">
		Hover or focus an electrode. Letters name the lobe <em>Fp</em> frontal pole · <em>F</em> frontal ·
		<em>C</em> central · <em>P</em> parietal · <em>O</em> occipital · <em>T</em> temporal.
		Odd numbers are left hemisphere, even are right, <em>z</em> is midline.
		Older papers still label <em>T7 T8 P7 P8</em> as <em>T3 T4 T5 T6</em> — same places, previous names.
	</p>
</figure>

<style>
	.eeg-stage{position:relative;max-width:23rem;margin:.4rem auto 0}
	.eeg-svg{width:100%}

	.eeg-head{fill:#fff;stroke:var(--accent);stroke-width:2.5}
	.eeg-nose{fill:none;stroke:var(--accent-dim);stroke-width:2.5;stroke-linejoin:round}
	.eeg-ear{fill:none;stroke:#b9a9e2;stroke-width:2.5}
	.eeg-guide{stroke:#c9bde2;stroke-width:1.5;stroke-dasharray:4 8}
	.eeg-ring{fill:none;stroke:#e0d8f2;stroke-width:1.5;stroke-dasharray:2 7}

	.eeg-el{cursor:pointer;outline:none}
	.eeg-hit{fill:transparent}
	.eeg-dot{fill:var(--accent);stroke:#fff;stroke-width:2;transition:fill .18s,r .18s}
	.eeg-lab{font:650 11px var(--font-sans);fill:#6a6f88;transition:fill .18s}
	.eeg-el:hover .eeg-dot,.eeg-el:focus-visible .eeg-dot{fill:var(--accent-dim)}
	.eeg-el:hover .eeg-lab,.eeg-el:focus-visible .eeg-lab{fill:var(--text)}
	.eeg-el:focus-visible .eeg-dot{stroke:var(--accent);stroke-width:3}
	.eeg-el.is-on .eeg-dot{fill:var(--accent-dim);animation:el-pulse 2.4s ease-in-out infinite}
	.eeg-el.is-on .eeg-lab{fill:var(--accent-dim);font-weight:750}
	@keyframes el-pulse{0%,100%{r:6.5}50%{r:8.5}}

	.eeg-tip{position:absolute;padding:.35rem .65rem;background:#20243c;color:#fff;border-radius:7px;
		box-shadow:3px 3px 0 #c6b6e5;font-size:.75rem;font-weight:600;white-space:nowrap;pointer-events:none;
		z-index:5;transform:translate(-50%,-100%);opacity:0;transition:opacity .15s}
	.eeg-tip[data-visible=true]{opacity:1}

	@media(prefers-reduced-motion:reduce){.eeg-el.is-on .eeg-dot{animation:none}}
	@media(max-width:560px){.eeg-stage{max-width:19rem}}
</style>

<script>
	document.querySelectorAll<HTMLElement>('.eeg-stage').forEach((stage) => {
		const tip = stage.querySelector<HTMLElement>('.eeg-tip');
		stage.querySelectorAll<SVGGElement>('.eeg-el').forEach((g) => {
			const label = g.dataset.label ?? '', region = g.dataset.region ?? '';
			const show = () => {
				if (!tip) return;
				const cr = g.querySelector('.eeg-dot')?.getBoundingClientRect();
				if (!cr) return;
				const rr = stage.getBoundingClientRect();
				tip.textContent = `${label} · ${region}`;
				tip.hidden = false; tip.dataset.visible = 'true';
				tip.style.left = `${cr.left + cr.width / 2 - rr.left}px`;
				tip.style.top = `${cr.top - rr.top - 8}px`;
			};
			const hide = () => { if (!tip) return; tip.dataset.visible = 'false';
				setTimeout(() => { if (tip.dataset.visible === 'false') tip.hidden = true; }, 150); };
			g.addEventListener('mouseenter', show); g.addEventListener('focus', show);
			g.addEventListener('mouseleave', hide); g.addEventListener('blur', hide);
			g.addEventListener('click', show);
			g.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); show(); }
				if (e.key === 'Escape') hide();
			});
		});
	});
</script>
