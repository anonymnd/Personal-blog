---
interface Step { id: string; label: string; desc: string; section?: string }

const steps: Step[] = [
	{ id: 'raw',      label: 'Raw EEG',         desc: 'Continuous voltage from every electrode.',        section: 'from-a-person-to-a-matrix-of-numbers' },
	{ id: 'filter',   label: 'Filtering',        desc: 'Strip drift, line hum, and out-of-band noise.',   section: 'what-is-filtering-doing' },
	{ id: 'artifact', label: 'Artifacts',        desc: 'Find and remove blinks, muscle, movement.',       section: 'and-there-is-a-lot-of-noise' },
	{ id: 'refer',    label: 'Re-referencing',   desc: 'Choose the common signal everything is measured against.', section: 'first-what-is-eeg-measuring' },
	{ id: 'epoch',    label: 'Epochs',           desc: 'Cut windows locked to each event.',               section: 'events-give-the-signal-context' },
	{ id: 'feature',  label: 'Features',         desc: 'Reduce to spectral, temporal, or spatial summaries.', section: 'raw-data-is-not-ready-for-machine-learning' },
	{ id: 'model',    label: 'Model',            desc: 'Finally: learn a mapping from prepared data.',    section: 'where-machine-learning-enters' },
];
---

<nav class="fig fig--paper pipe" aria-label="Preprocessing pipeline">
	<p class="fig-kicker">Overview · the pipeline</p>
	<h3 class="fig-title">Seven steps sit between the scalp and the model</h3>

	<ol class="steps">
		{steps.map((s, i) => (
			<li class="step" data-step={s.id}>
				<a class="step-a" href={`#${s.section}`}>
					<span class="step-n" aria-hidden="true">{i + 1}</span>
					<span class="step-txt">
						<strong>{s.label}</strong>
						<span class="step-d">{s.desc}</span>
					</span>
				</a>
			</li>
		))}
	</ol>

	<p class="fig-note">
		The model is <em>last</em>. Most of the scientific judgement — and most of the room to get it wrong —
		happens in the six steps before it ever runs.
	</p>
</nav>

<style>
	.steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}

	.step{position:relative}
	.step-a{display:flex;align-items:flex-start;gap:.75rem;padding:.7rem .85rem;background:#fff;border:1px solid #e2ddf0;
		border-radius:12px;text-decoration:none;color:var(--text);min-height:48px;transition:transform .18s,box-shadow .18s,border-color .18s}
	.step-a:hover{transform:translateY(-2px);box-shadow:0 4px 0 #e6e1f3;border-color:#cfc5e6}
	.step-a:focus-visible{outline:3px solid var(--accent);outline-offset:2px}

	.step-n{flex-shrink:0;width:34px;height:34px;display:grid;place-items:center;background:var(--accent);color:#fff;
		border-radius:10px;font-size:.95rem;font-weight:800;letter-spacing:-.02em;box-shadow:3px 3px 0 #c6b6e5}
	.step-txt{display:flex;flex-direction:column;gap:.12rem;min-width:0}
	.step-txt strong{font-size:.88rem;font-weight:700;line-height:1.4}
	.step-active .step-n{background:var(--accent-dim);box-shadow:4px 4px 0 #c6b6e5}
	.step-active .step-txt strong{color:var(--accent)}
	.step-d{font-size:.76rem;line-height:1.6;color:var(--text-muted)}

	@media(prefers-reduced-motion:reduce){.step-a{transition:none}.step-a:hover{transform:none;box-shadow:none}}
	@media(max-width:560px){.steps{grid-template-columns:1fr}}
</style>

<script>
	const steps = document.querySelectorAll<HTMLElement>('.step');
	if (steps.length && 'IntersectionObserver' in window) {
		const bySection = new Map<string, HTMLElement>();
		steps.forEach((s) => {
			const href = s.querySelector<HTMLAnchorElement>('a')?.getAttribute('href')?.slice(1);
			if (href) bySection.set(href, s);
		});
		const io = new IntersectionObserver((entries) => {
			entries.forEach((e) => {
				if (!e.isIntersecting) return;
				const s = bySection.get(e.target.id);
				if (!s) return;
				steps.forEach((x) => x.classList.remove('step-active'));
				s.classList.add('step-active');
			});
		}, { rootMargin: '-15% 0px -70% 0px' });
		document.querySelectorAll<HTMLElement>('h2[id],section[id]').forEach((el) => io.observe(el));
	}
</script>
