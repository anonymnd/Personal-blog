---
interface Step {
	id: string;
	label: string;
	desc: string;
	section?: string; // optional anchor link
}

const steps: Step[] = [
	{ id: 'raw', label: 'Raw EEG', desc: 'Continuous voltage recordings from all electrodes.', section: 'from-a-person-to-a-matrix-of-numbers' },
	{ id: 'filter', label: 'Filtering', desc: 'Remove drifts, line noise, and out-of-band frequencies.', section: 'what-is-filtering-doing' },
	{ id: 'artifact', label: 'Artifact handling', desc: 'Detect and remove blinks, muscle activity, and movement.', section: 'and-there-is-a-lot-of-noise' },
	{ id: 'channels', label: 'Channel selection', desc: 'Keep relevant electrodes; interpolate or drop bad ones.', section: 'channels-also-have-spatial-meaning' },
	{ id: 'epoch', label: 'Time windows', desc: 'Cut the continuous signal into epochs around events.', section: 'events-give-the-signal-context' },
	{ id: 'features', label: 'Features', desc: 'Extract spectral, temporal, or spatial features.', section: 'raw-data-is-not-ready-for-machine-learning' },
	{ id: 'model', label: 'Model', desc: 'Train a classifier or regressor on prepared data.', section: 'where-machine-learning-enters' },
];
---

<nav class="pipeline-stepper" aria-label="Preprocessing pipeline overview">
	<p class="pipeline-title">The preprocessing pipeline at a glance</p>
	<ol class="stepper-list">
		{steps.map((step, i) => (
			<li class="step" data-step={step.id}>
				{step.section ? (
					<a href={`#${step.section}`} class="step-link">
						<span class="step-num" aria-hidden="true">{i + 1}</span>
						<span class="step-body">
							<strong class="step-label">{step.label}</strong>
							<span class="step-desc">{step.desc}</span>
						</span>
					</a>
				) : (
					<div class="step-link step-link--static">
						<span class="step-num" aria-hidden="true">{i + 1}</span>
						<span class="step-body">
							<strong class="step-label">{step.label}</strong>
							<span class="step-desc">{step.desc}</span>
						</span>
					</div>
				)}
			</li>
		))}
	</ol>
	<p class="pipeline-note">The model sits at the end — most of the work happens before it.</p>
</nav>

<style>
	.pipeline-stepper {
		margin: 2rem 0 2.5rem;
		padding: 1.4rem;
		background: #eeedf9;
		border: 1px solid #dcd6ee;
		border-inline-start: 4px solid var(--accent-dim);
		border-radius: 0 14px 14px 0;
	}

	.pipeline-title {
		font-size: 0.7rem;
		font-weight: 650;
		color: #634a98;
		margin-bottom: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.stepper-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.step {
		position: relative;
	}
	.step:not(:last-child)::after {
		content: '';
		position: absolute;
		inset-inline-start: 17px;
		bottom: -0.5rem;
		width: 2px;
		height: 0.5rem;
		background: #c5bee0;
	}

	.step-link {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 0.6rem 0.75rem;
		border-radius: 8px;
		text-decoration: none;
		color: var(--text);
		min-height: 44px;
		transition: background 0.15s;
	}
	a.step-link:hover { background: #e1d9f2; }
	.step-link:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }

	.step-num {
		flex-shrink: 0;
		width: 34px;
		height: 34px;
		display: grid;
		place-items: center;
		background: #fff;
		border: 2px solid #c5bee0;
		border-radius: 50%;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--accent-dim);
	}

	.step-body {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}

	.step-label {
		font-size: 0.88rem;
		font-weight: 650;
	}

	.step-desc {
		font-size: 0.8rem;
		line-height: 1.6;
		color: var(--text-muted);
	}

	.pipeline-note {
		margin: 1rem 0 0;
		padding: 0.6rem 0.8rem;
		border-inline-start: 3px solid var(--accent);
		background: #e1e6fa;
		color: #333c75;
		font-size: 0.82rem;
		line-height: 1.7;
	}

	@media (max-width: 560px) {
		.step-num { width: 28px; height: 28px; font-size: 0.7rem; }
	}
</style>

<script>
	// Scroll-spy: highlight step as user scrolls through related sections
	const steps = document.querySelectorAll<HTMLElement>('.step');
	if (steps.length && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						steps.forEach((s) => s.classList.remove('step-active'));
						const id = entry.target.getAttribute('id');
						const matching = document.querySelector<HTMLElement>(`.step[data-step] .step-link[href="#${id}"]`);
						if (matching) {
							matching.closest('.step')?.classList.add('step-active');
						}
					}
				});
			},
			{ rootMargin: '-20% 0px -60% 0px' }
		);

		document.querySelectorAll<HTMLElement>('section[id], h2[id]').forEach((el) => {
			observer.observe(el);
		});
	}
</script>

<style>
	.step-active .step-num {
		background: var(--accent-dim);
		border-color: var(--accent-dim);
		color: #fff;
	}
	.step-active .step-label {
		color: var(--accent-dim);
	}

	@media (prefers-reduced-motion: reduce) {
		.step-link { transition: none; }
	}
</style>
