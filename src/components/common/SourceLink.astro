---
/**
 * Compact inline source marker — a visually secondary chip that links to the
 * original paper. Deliberately small so it sits inside a paragraph without
 * turning the article into an academic reference list.
 */
interface Props {
	authors: string;
	year: string;
	href: string;
	title?: string;
}

const { authors, year, href, title } = Astro.props;
const label = title ? `${authors} (${year}), ${title}` : `${authors}, ${year}`;
---

<a class="src" href={href} target="_blank" rel="noopener noreferrer"
	aria-label={`${label} — opens the original paper in a new tab`}>
	<span class="src-txt">{authors}, {year}</span><span class="src-go" aria-hidden="true">↗</span>
</a>

<style>
	.src {
		display: inline-flex;
		align-items: baseline;
		gap: 0.22em;
		margin-inline: 0.18em;
		padding: 0.05em 0.42em 0.1em;
		border-radius: 5px;
		border: 1px solid #e4dff0;
		background: #f4f1fb;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.68em;
		font-weight: 500;
		line-height: 1.6;
		white-space: nowrap;
		text-decoration: none;
		vertical-align: 0.08em;
		transition: background 0.16s, color 0.16s, border-color 0.16s;
	}

	.src-go {
		font-size: 0.9em;
		opacity: 0.7;
	}

	.src:hover {
		background: #edebf9;
		border-color: #cfc5e6;
		color: var(--accent-dim);
	}

	.src:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.src { transition: none; }
	}

	@media (max-width: 560px) {
		.src { font-size: 0.64em; }
	}
</style>
