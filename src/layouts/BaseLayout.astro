---
import '../styles/global.css';
import { journal } from '../i18n/design';
import LocaleBar from '../components/LocaleBar.astro';
import { blogIndexHref, homeHref, isRtl, type Locale } from '../i18n/locales';
import { layoutStrings } from '../i18n/ui';
import { withBase } from '../utils/url';

interface Props {
	title: string;
	description?: string;
	lang: Locale;
	localeHrefs: Record<Locale, string>;
	/** For post pages: which translations exist (others link to blog index). */
	availableLocales?: Set<Locale>;
}

const {
	title,
	description = 'Learning notes in computer science and IT—by Nada Tayebi.',
	lang,
	localeHrefs,
	availableLocales,
} = Astro.props;

const L = layoutStrings(lang);
const pageTitle = title === L.siteTitle ? `${title} · ${L.siteSubtitle}` : `${title} · ${L.siteTitle}`;
const dir = isRtl(lang) ? 'rtl' : 'ltr';
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{pageTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&family=Libre+Bodoni:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+Arabic:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class:list={{ 'font-ar': lang === 'ar' }}>
		<a href="#main" class="skip">{L.skipToContent}</a>
		<header class="site-header">
			<div class="inner">
				<div class="brand">
					<a href={homeHref(lang)} class="logo">{L.siteTitle}</a>
					<span class="subtitle">{L.siteSubtitle}</span>
				</div>
				<div class="header-right">
					<nav class="main-nav" aria-label="Primary">
						<a href={homeHref(lang)} aria-current={Astro.url.pathname === homeHref(lang) ? "page" : undefined}>{L.navHome}</a>
						<a href={blogIndexHref(lang)} aria-current={Astro.url.pathname.startsWith(blogIndexHref(lang)) ? "page" : undefined}>{L.navBlog}</a>
					</nav>
					<LocaleBar lang={lang} hrefs={localeHrefs} available={availableLocales} />
				</div>
			</div>
		</header>
		<main id="main">
			<slot />
		</main>
		<footer class="site-footer">
			<p>{journal(lang).footer}</p>
		</footer>
	</body>
</html>

<style is:global>
	.font-ar {
		font-family: 'Noto Sans Arabic', 'Public Sans', system-ui, sans-serif;
	}

	.skip {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		background: var(--accent);
		color: var(--bg);
		font-weight: 600;
		z-index: 100;
	}
	.skip:focus {
		inset-inline-start: 1rem;
		top: 1rem;
		width: auto;
		height: auto;
		padding: 0.5rem 1rem;
		margin: 0;
		overflow: visible;
		clip-path: none;
		white-space: normal;
	}

</style>
